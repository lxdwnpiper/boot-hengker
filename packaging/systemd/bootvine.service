[Unit]
Description=Live dependency tree of boot jobs
DefaultDependencies=no
IgnoreOnIsolate=yes
Before=display-manager.service shutdown.target
Conflicts=shutdown.target

[Service]
Type=simple
ExecStart=@/usr/bin/bootvine @bootvine
StandardInput=tty
StandardOutput=tty
StandardError=journal
TTYPath=/dev/tty12
TTYReset=yes
TTYVTDisallocate=no

[Install]
WantedBy=sysinit.target
